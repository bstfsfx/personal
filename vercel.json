{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/status", "dest": "/api/status.js" },
    { "src": "/api/contact", "dest": "/api/contact.js" }
  ],
  "cleanUrls": true
}
